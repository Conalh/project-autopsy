{
  "name": "@project-autopsy/web",
  "version": "0.2.0",
  "description": "Web report surface for Project Autopsy.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "vitest run && tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reportsDirectory=../../coverage/web && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@project-autopsy/core": "file:../../packages/core",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
